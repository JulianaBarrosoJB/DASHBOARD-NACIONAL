# PostgreSQL / Neon (use a role with only the required MotorView privileges)
DATABASE_URL=

# HiveMQ Cloud - use the subscribe-only credential
MOTORVIEW_MQTT_HOST=
MOTORVIEW_MQTT_PORT=8883
MOTORVIEW_MQTT_USERNAME=
MOTORVIEW_MQTT_PASSWORD=
MOTORVIEW_MQTT_TOPIC_FILTER=motorview/planta1/#
MOTORVIEW_MQTT_CLIENT_ID=motorview-neon-ingest-planta1

# Worker
MOTORVIEW_INGEST_QUEUE_SIZE=10000
MOTORVIEW_INGEST_LOG_LEVEL=INFO
